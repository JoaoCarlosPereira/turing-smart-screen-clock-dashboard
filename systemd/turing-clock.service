[Unit]
Description=Relogio da tela Turing IPS
Documentation=file:%h/dsv/turing-smart-screen-python/RELOGIO.md
# Starts at boot with the user manager (default.target, needs `loginctl
# enable-linger`) and is also wanted by the desktop session. Only the session
# D-Bus/PipeWire are required, not a Wayland/X display. RequiresMountsFor waits
# for /mnt/Dados (fstab) so we do not spin while the Dados volume is unmounted;
# on hosts without a separate Dados disk (project lives under $HOME instead),
# this resolves against the already-active root mount and is a no-op.
After=graphical-session.target
RequiresMountsFor=/mnt/Dados
StartLimitIntervalSec=0

[Service]
Type=simple
# Launcher lives on the home filesystem and resolves /mnt/Dados at runtime.
# Never point ExecStart at /run/media — that path is not stable across remounts.
ExecStart=%h/.local/share/turing-smart-screen/bin/run-clock-display.sh
Restart=always
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=8
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target graphical-session.target

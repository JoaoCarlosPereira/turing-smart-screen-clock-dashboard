[Unit]
Description=Relogio da tela Turing IPS
Documentation=file:/mnt/Dados/dsv/turing-smart-screen-python/RELOGIO.md
# Start with the desktop session. RequiresMountsFor waits for /mnt/Dados (fstab)
# so we do not spin while the Dados volume is still unmounted.
After=graphical-session.target
Wants=graphical-session.target
RequiresMountsFor=/mnt/Dados
StartLimitIntervalSec=0

[Service]
Type=simple
# Launcher lives on the home filesystem and resolves /mnt/Dados at runtime.
# Never point ExecStart at /run/media — that path is not stable across remounts.
ExecStart=%h/.local/share/turing-smart-screen/bin/run-clock-display.sh
Restart=always
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=8
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
